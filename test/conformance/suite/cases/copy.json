  {
    "id": "copy.group_members_are_each_answered",
    "rule": "Adding followers to a group sends their ids with the idempotency key, and each follower's outcome is answered apart",
    "source": "Copy Trading",
    "call": {
      "op": "copy.add_group_followers",
      "args": {
        "group_id": "06abfa00-0000-7000-8000-0000000000e1",
        "follower_ids": [
          "06abfa00-0000-7000-8000-0000000000f1",
          "06abfa00-0000-7000-8000-0000000000f2"
        ],
        "idempotency_key": "case-copy-9"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/groups/06abfa00-0000-7000-8000-0000000000e1/followers",
          "headers": {
            "Idempotency-Key": "case-copy-9"
          },
          "json": {
            "follower_ids": [
              "06abfa00-0000-7000-8000-0000000000f1",
              "06abfa00-0000-7000-8000-0000000000f2"
            ]
          }
        },
        "answer": {
          "status": 200,
          "body": {
            "results": [
              {
                "follower_id": "06abfa00-0000-7000-8000-0000000000f1",
                "outcome": "done",
                "reason": null
              },
              {
                "follower_id": "06abfa00-0000-7000-8000-0000000000f2",
                "outcome": "refused",
                "reason": "in_another_group"
              }
            ]
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "outcomes": [
          "done",
          "refused"
        ],
        "reasons": [
          null,
          "in_another_group"
        ]
