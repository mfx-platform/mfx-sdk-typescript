  {
    "id": "copy.unfollow_closes_copied_only_when_asked",
    "rule": "Unfollowing sends close_copied exactly as the caller chose, and the follower comes back unfollowed",
    "source": "Copy Trading",
    "call": {
      "op": "copy.unfollow",
      "args": {
        "follower_id": "06abfa00-0000-7000-8000-0000000000f1",
        "close_copied": false,
        "idempotency_key": "case-copy-7"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/followers/06abfa00-0000-7000-8000-0000000000f1/unfollow",
          "headers": {
            "Idempotency-Key": "case-copy-7"
          },
          "json": {
            "close_copied": false
          }
        },
        "answer": {
          "status": 200,
          "body": {
            "$fixture": "copy_follower",
            "state": "unfollowed"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "state": "unfollowed"
      }
    }
  },
  {
    "id": "copy.stopout_reset_with_none_active_is_a_state_error",
    "rule": "Resetting a follower's stop-outs when none is active is a state error naming no_active_stopout, and the write is not sent again",
    "source": "Copy Trading",
    "call": {
      "op": "copy.reset_stopouts",
      "args": {
        "follower_id": "06abfa00-0000-7000-8000-0000000000f1",
        "reason": "limit raised",
        "idempotency_key": "case-copy-8"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/followers/06abfa00-0000-7000-8000-0000000000f1/stopouts/reset",
          "headers": {
            "Idempotency-Key": "case-copy-8"
          },
          "json": {
            "reason": "limit raised"
          }
        },
        "answer": {
          "status": 409,
          "body": {
            "error": {
              "code": "state_error",
              "message": "no active stop-out",
              "details": {
                "reason": "no_active_stopout"
              }
            }
          }
        }
      }
    ],
    "observe": {
      "raises": "StateError",
      "fields": {
        "code": "state_error",
        "status": 409
      }
    }
  },
  {
    "id": "copy.log_filters_are_comma_joined_and_the_window_is_sent",
    "rule": "Reading the copy log sends each list filter as one comma-separated value and the window as instants, and keeps the stats row over the whole window",
    "source": "Copy Trading",
    "call": {
      "op": "copy.log",
      "args": {
        "outcome": [
          "refused",
          "skipped"
        ],
        "reason": [
          "mapping",
          "min_volume"
        ],
        "from": "2026-11-12T00:00:00Z",
        "to": "2026-11-13T00:00:00Z"
      }
    },
    "server": [
      {
        "expect": {
          "method": "GET",
          "path": "/v1/copy/log",
          "query": {
            "outcome": "refused,skipped",
            "reason": "mapping,min_volume"
          },
          "query_instants": {
            "from": "2026-11-12T00:00:00Z",
            "to": "2026-11-13T00:00:00Z"
          }
        },
        "answer": {
          "status": 200,
          "body": {
            "stats": {
              "copies": 2,
              "filled": 0,
              "refused": 2,
              "skipped": 0,
              "stopout": 0,
              "mfx_ms_p50": 11.5,
              "mfx_ms_p99": 11.5,
              "signal_to_order_ms_p50": 14.0,
              "broker_ms_p50": null,
              "mfx_ms_p95": 30.0,
              "signal_to_order_ms_p95": 35.0,
              "broker_ms_p95": null
            },
            "items": [
              {
                "$fixture": "copy_log_row"
              },
              {
                "$fixture": "copy_log_row",
                "reason": "min_volume"
              }
            ],
            "next_cursor": null,
            "returned": 2
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "count": 2,
        "reasons": [
          "mapping",
          "min_volume"
        ],
        "stats_refused": 2
      }
    }
  },
