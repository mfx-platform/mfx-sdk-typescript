[
  {
    "id": "copy.leader_create_sends_the_account_and_the_key",
    "rule": "Making an account a leader sends its source, account and signal lifetime with the idempotency key, and returns the leader, active",
    "source": "Copy Trading",
    "call": {
      "op": "copy.create_leader",
      "args": {
        "source": "account",
        "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "signal_lifetime_s": 30,
        "idempotency_key": "case-copy-1"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/leaders",
          "headers": {
            "Idempotency-Key": "case-copy-1"
          },
          "json": {
            "source": "account",
            "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405060",
            "signal_lifetime_s": 30
          }
        },
        "answer": {
          "status": 201,
          "body": {
            "$fixture": "copy_leader"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "id": "06abfa00-0000-7000-8000-0000000000c1",
        "source": "account",
        "state": "active"
      }
    }
  },
  {
    "id": "copy.leader_over_the_plan_is_quota_exceeded",
    "rule": "A leader over the plan's number of leaders is a conflict naming quota_exceeded, and the write is not sent again",
    "source": "Copy Trading",
    "call": {
      "op": "copy.create_leader",
      "args": {
        "source": "external",
        "signal_lifetime_s": 30,
        "idempotency_key": "case-copy-2"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/leaders",
          "headers": {
            "Idempotency-Key": "case-copy-2"
          },
          "json": {
            "source": "external",
            "signal_lifetime_s": 30
          }
        },
        "answer": {
          "status": 409,
          "body": {
            "error": {
              "code": "quota_exceeded",
              "message": "over the plan's leaders",
              "details": {
                "reason": "plan_limit",
                "limit": "copy_leaders"
              }
            }
          }
        }
      }
    ],
    "observe": {
      "raises": "ConflictError",
      "fields": {
        "code": "quota_exceeded",
        "status": 409
      }
    }
  },
  {
    "id": "copy.leaders_filter_by_state_and_follow_the_cursor",
    "rule": "Listing leaders sends the states as one comma-separated value, follows next_cursor until it is null, and keeps the stats row",
    "source": "Copy Trading",
    "call": {
      "op": "copy.leaders",
      "args": {
        "state": [
          "active",
          "paused"
        ]
      }
    },
    "server": [
      {
        "expect": {
          "method": "GET",
          "path": "/v1/copy/leaders",
          "query": {
            "state": "active,paused"
          }
        },
        "answer": {
          "status": 200,
          "body": {
            "stats": {
              "leaders": 2,
              "active": 1,
              "paused": 1,
              "retired": 0
            },
            "items": [
              {
                "$fixture": "copy_leader"
              }
            ],
            "next_cursor": "c-2",
            "returned": 1
          }
        }
      },
      {
        "expect": {
          "method": "GET",
          "path": "/v1/copy/leaders",
          "query": {
            "state": "active,paused",
            "cursor": "c-2"
          }
        },
        "answer": {
          "status": 200,
          "body": {
            "stats": {
              "leaders": 2,
              "active": 1,
              "paused": 1,
              "retired": 0
            },
            "items": [
              {
                "$fixture": "copy_leader",
                "id": "06abfa00-0000-7000-8000-0000000000c2",
                "state": "paused"
              }
            ],
            "next_cursor": null,
            "returned": 1
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "ids": [
          "06abfa00-0000-7000-8000-0000000000c1",
          "06abfa00-0000-7000-8000-0000000000c2"
        ],
        "stats_leaders": 2
      }
    }
  },
  {
    "id": "copy.signal_sent_again_is_the_original",
    "rule": "An external leader's open signal sends its own id and the volume as a decimal string; an id sent before is answered with the original signal, marked duplicate",
    "source": "Copy Trading",
    "call": {
      "op": "copy.send_open_signal",
      "args": {
        "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
        "id": "s-1",
        "symbol": "EURUSD",
        "side": "buy",
        "volume": {
          "$decimal": "1.50"
        },
        "idempotency_key": "case-copy-3"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/leaders/06abfa00-0000-7000-8000-0000000000c1/signals",
          "headers": {
            "Idempotency-Key": "case-copy-3"
          },
          "json": {
            "id": "s-1",
            "symbol": "EURUSD",
            "side": "buy",
            "volume": "1.50"
          }
        },
        "answer": {
          "status": 202,
          "body": {
            "signal_id": "06abfa00-0000-7000-8000-0000000000d1",
            "id": "s-1",
            "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
            "duplicate": true,
            "iat": "2026-11-13T09:00:00Z",
            "exp": "2026-11-13T09:00:30Z"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "signal_id": "06abfa00-0000-7000-8000-0000000000d1",
        "duplicate": true
      }
    }
  },
  {
    "id": "copy.signal_float_volume_refused",
    "rule": "A binary floating-point signal volume is refused before anything is sent",
    "source": "Copy Trading",
    "call": {
      "op": "copy.send_open_signal",
      "args": {
        "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
        "id": "s-2",
        "symbol": "EURUSD",
        "side": "buy",
        "volume": {
          "$float": 0.30000000000000004
        },
        "idempotency_key": "case-copy-4"
      }
    },
    "server": [],
    "observe": {
      "refuses": "invalid_argument"
    }
  },
  {
    "id": "copy.follow_sends_the_mandate",
    "rule": "Following a leader sends the account, the leader and the scaling with the idempotency key, and returns the follower, copying, at mandate version 1",
    "source": "Copy Trading",
    "call": {
      "op": "copy.create_follower",
      "args": {
        "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405061",
        "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
        "scaling": {
          "mode": "fixed_multiplier",
          "multiplier": "0.5"
        },
        "idempotency_key": "case-copy-5"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/followers",
          "headers": {
            "Idempotency-Key": "case-copy-5"
          },
          "json": {
            "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405061",
            "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
            "scaling": {
              "mode": "fixed_multiplier",
              "multiplier": "0.5"
            }
          }
        },
        "answer": {
          "status": 201,
          "body": {
            "$fixture": "copy_follower"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "id": "06abfa00-0000-7000-8000-0000000000f1",
        "state": "copying",
        "mandate_version": 1
      }
    }
  },
  {
    "id": "copy.follow_from_an_account_the_venue_cannot_copy_to_is_refused",
    "rule": "A follow from an account its venue cannot copy to, such as an MT5 netting account, is a validation error naming not_on_this_venue and margin_mode, checked when it is made and not sent again",
    "source": "Copy Trading",
    "call": {
      "op": "copy.create_follower",
      "args": {
        "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405062",
        "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
        "scaling": {
          "mode": "balance_ratio"
        },
        "idempotency_key": "case-copy-6"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/copy/followers",
          "headers": {
            "Idempotency-Key": "case-copy-6"
          },
          "json": {
            "account_id": "4c2d3e4f-5a6b-7c8d-9e0f-102030405062",
            "leader_id": "06abfa00-0000-7000-8000-0000000000c1",
            "scaling": {
              "mode": "balance_ratio"
            }
          }
        },
        "answer": {
          "status": 422,
          "body": {
            "error": {
              "code": "unprocessable",
              "message": "an MT5 netting account cannot follow",
              "details": {
                "reason": "not_on_this_venue",
                "options": [
                  "margin_mode"
                ]
              }
            }
          }
        }
      }
    ],
    "observe": {
      "raises": "ValidationError",
      "fields": {
        "code": "unprocessable",
        "status": 422
      }
    }
  },
  {
