[
  {
    "id": "agreement.not_accepted_names_the_plan_change_documents_and_accept_url",
    "rule": "A terminal refused while a plan change awaits the new plan's Service Agreement is a ServiceAgreementNotAcceptedError that keeps the code and gives details.plan_change, details.documents and details.accept_url as sent; the write is not sent again",
    "source": "Plan agreements",
    "call": {
      "op": "terminals.create",
      "args": {
        "farm_id": "1c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "broker_id": "2c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "server_id": "3c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "idempotency_key": "case-key-sa-1"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/terminals",
          "headers": {
            "Idempotency-Key": "case-key-sa-1"
          }
        },
        "answer": {
          "status": 409,
          "headers": {
            "MFX-Service-Agreement": "due"
          },
          "body": {
            "error": {
              "code": "service_agreement_not_accepted",
              "message": "the Enterprise Service Agreement must be accepted before anything is added",
              "details": {
                "plan_change": {
                  "$fixture": "plan_change"
                },
                "documents": [
                  {
                    "document": "service_agreement_enterprise",
                    "number": 1,
                    "plan": "enterprise",
                    "grace_ends_at": null
                  }
                ],
                "accept_url": "https://portal.mfxhub.com/organisation/legal"
              }
            }
          }
        }
      }
    ],
    "observe": {
      "raises": "ServiceAgreementNotAcceptedError",
      "fields": {
        "code": "service_agreement_not_accepted",
        "status": 409,
        "details": {
          "plan_change": {
            "$fixture": "plan_change"
          },
          "documents": [
            {
              "document": "service_agreement_enterprise",
              "number": 1,
              "plan": "enterprise",
              "grace_ends_at": null
            }
          ],
          "accept_url": "https://portal.mfxhub.com/organisation/legal"
        }
      }
    }
  },
  {
