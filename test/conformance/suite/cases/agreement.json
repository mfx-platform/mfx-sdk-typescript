            "due": false,
            "held": false,
            "plan": "enterprise",
            "plan_change": null,
            "documents": [],
            "accept_url": "https://portal.mfxhub.com/organisation/legal"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "due": false,
        "held": false,
        "plan": "enterprise",
        "plan_change_state": null,
        "plan_change_to": null,
        "documents": [],
        "accept_url": "https://portal.mfxhub.com/organisation/legal"
      }
    }
  },
  {
    "id": "agreement.due_header_warns_once_per_client",
    "rule": "A client that sees MFX-Service-Agreement: due logs one warning the first time, not one per answer: three answers carrying it are one warning",
    "source": "Plan agreements",
    "call": {
      "op": "agreement.due_warnings",
      "args": {
        "terminal_id": "0191f0c2-aaaa-7bbb-8ccc-000000000001",
        "clients": 1,
        "calls": 3
      }
    },
    "server": [
      {
        "expect": {
          "method": "GET",
          "path": "/v1/terminals/0191f0c2-aaaa-7bbb-8ccc-000000000001"
        },
        "answer": {
          "status": 200,
          "headers": {
            "MFX-Service-Agreement": "due"
          },
          "body": {
            "$fixture": "terminal"
          }
        },
        "times": 3
      }
    ],
    "observe": {
      "returns": {
        "warnings": 1
      }
    }
  },
