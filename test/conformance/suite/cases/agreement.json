  {
    "id": "agreement.terms_not_accepted_names_the_documents",
    "rule": "A terminal refused while a Terms version is past its grace period unaccepted is a TermsNotAcceptedError that keeps the code and gives details.documents as sent",
    "source": "Plan agreements",
    "call": {
      "op": "terminals.create",
      "args": {
        "farm_id": "1c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "broker_id": "2c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "server_id": "3c2d3e4f-5a6b-7c8d-9e0f-102030405060",
        "idempotency_key": "case-key-terms-1"
      }
    },
    "server": [
      {
        "expect": {
          "method": "POST",
          "path": "/v1/terminals",
          "headers": {
            "Idempotency-Key": "case-key-terms-1"
          }
        },
        "answer": {
          "status": 409,
          "headers": {
            "MFX-Service-Agreement": "due"
          },
          "body": {
            "error": {
              "code": "terms_not_accepted",
              "message": "the Terms of Service must be accepted before anything is added",
              "details": {
                "documents": [
                  {
                    "document": "terms",
                    "number": 3,
                    "grace_ends_at": "2026-11-10T00:00:00Z"
                  }
                ]
              }
            }
          }
        }
      }
    ],
    "observe": {
      "raises": "TermsNotAcceptedError",
      "fields": {
        "code": "terms_not_accepted",
        "status": 409,
        "details": {
          "documents": [
            {
              "document": "terms",
              "number": 3,
              "grace_ends_at": "2026-11-10T00:00:00Z"
            }
          ]
        }
      }
    }
  },
  {
    "id": "agreement.service_agreement_reads_what_is_due",
    "rule": "tenant.service_agreement() reads GET /v1/tenant/service-agreement and returns what is due, whether additions are held, the plan in force, the plan change, every document due and accept_url",
    "source": "Plan agreements",
    "call": {
      "op": "tenant.service_agreement",
      "args": {}
    },
    "server": [
      {
        "expect": {
          "method": "GET",
          "path": "/v1/tenant/service-agreement"
        },
        "answer": {
          "status": 200,
          "headers": {
            "MFX-Service-Agreement": "due"
          },
          "body": {
            "due": true,
            "held": true,
            "plan": "standard",
            "plan_change": {
              "$fixture": "plan_change"
            },
            "documents": [
              {
                "document": "service_agreement_enterprise",
                "number": 1,
                "plan": "enterprise",
                "grace_ends_at": null,
                "held": true
              }
            ],
            "accept_url": "https://portal.mfxhub.com/organisation/legal"
          }
        }
      }
    ],
    "observe": {
      "returns": {
        "due": true,
        "held": true,
        "plan": "standard",
        "plan_change_state": "awaiting_acceptance",
        "plan_change_to": "enterprise",
        "documents": [
          "service_agreement_enterprise"
        ],
        "accept_url": "https://portal.mfxhub.com/organisation/legal"
      }
    }
  },
  {
